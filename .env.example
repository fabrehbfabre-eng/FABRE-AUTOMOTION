# FABRE AUTOMATION - Environment Variables
# Release 2: Supabase Persistence Foundation

# -------------------------------------------------------------
# CLIENT-SIDE / PUBLIC (Safe to be exposed in browser bundle)
# -------------------------------------------------------------
# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=

# Supabase Publishable / Anon Key (Safe for client-side queries with RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=

# -------------------------------------------------------------
# SERVER-SIDE ONLY (NEVER expose to frontend or public git!)
# Utilizado exclusivamente em Supabase Edge Functions / Backend
# -------------------------------------------------------------
# SUPABASE_SECRET_KEY=
# OPENAI_API_KEY=
# META_ACCESS_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WEBHOOK_VERIFY_TOKEN=
# META_APP_SECRET=
