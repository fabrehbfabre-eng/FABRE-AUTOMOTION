# ==============================================================================
# FABRE AUTOMATION - Environment Variables Specification
# Release 3: Secure Backend Foundation
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE / PUBLIC (React/Vite Bundle)
# ------------------------------------------------------------------------------
# ATENÇÃO: Apenas variáveis prefixadas com VITE_ são expostas ao navegador.
# Devem conter APENAS chaves públicas com Row Level Security (RLS) ativo.

# URL do Projeto Supabase (Ex: https://seu-projeto.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave Pública Anon/Publishable do Supabase (Apenas chave pública com RLS)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave_publica_aqui
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 2. INFRASTRUCTURE & MANAGEMENT (Supabase CLI / Management API)
# ------------------------------------------------------------------------------
# Personal Access Token do Supabase (para link, deploy de Edge Functions e provisionamento)
# Configurado de forma segura no ambiente/Settings do AI Studio
SUPABASE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 3. SERVER-SIDE ONLY (Supabase Edge Functions / Deno Environment)
# ------------------------------------------------------------------------------
# ATENÇÃO CRÍTICA DE SEGURANÇA:
# NUNCA utilizar essas variáveis no código React.
# NUNCA prefixar com VITE_.
# Estas variáveis devem ser configuradas exclusivamente no painel do Supabase
# (Project Settings > Edge Functions > Secrets) ou via Supabase CLI.

# Chave privilegiada de serviço do Supabase (Acesso irrestrito com bypass de RLS para Edge Functions)
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Chave Secreta da OpenAI API (gpt-4o-mini / Embeddings)
# OPENAI_API_KEY=

# Segredo do App Meta (Utilizado para validar a assinatura SHA256 dos Webhooks da Meta)
# META_APP_SECRET=

# Token de Acesso de Longa Duração da Meta Graph API (Instagram Direct & Messenger)
# META_ACCESS_TOKEN=

# Token de Acesso Permanente da WhatsApp Business Cloud API
# WHATSAPP_ACCESS_TOKEN=

# Identificador da Linha Telefônica do WhatsApp Business (Phone Number ID - Ativo ADM01: 250763631462152)
# WHATSAPP_PHONE_NUMBER_ID=

# Identificador da Conta WhatsApp Business (WABA ID - Ativo ADM01: 293410900513919)
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# Identificador do Aplicativo Meta (App ID)
# META_APP_ID=

# Token Secreto de Verificação de Webhooks (Configurado no Meta App Dashboard)
# WEBHOOK_VERIFY_TOKEN=
